{
  "name": "decleanup-contracts",
  "version": "1.0.0",
  "description": "DeCleanup Rewards smart contracts for Base",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:base": "hardhat run scripts/deployUpgradeable.js --network base",
    "deploy:baseSepolia": "hardhat run scripts/deployUpgradeable.js --network baseSepolia",
    "verify:basescan": "hardhat run scripts/verify-on-basescan.js --network base",
    "upgrade:pointsDistributor:base": "hardhat run scripts/upgradePointsRewardDistributor.js --network base",
    "upgrade:pointsDistributor:baseSepolia": "hardhat run scripts/upgradePointsRewardDistributor.js --network baseSepolia",
    "upgrade:verification:base": "hardhat run scripts/upgradeVerificationContract.js --network base",
    "upgrade:verification:baseSepolia": "hardhat run scripts/upgradeVerificationContract.js --network baseSepolia",
    "upgrade:impactNFT:base": "hardhat run scripts/upgradeImpactProductNFT.js --network base",
    "upgrade:impactNFT:baseSepolia": "hardhat run scripts/upgradeImpactProductNFT.js --network baseSepolia",
    "upgrade:all:base": "hardhat run scripts/upgradeAll.js --network base",
    "upgrade:all:baseSepolia": "hardhat run scripts/upgradeAll.js --network baseSepolia",
    "addVerifier:base": "node run-addVerifier.js base",
    "addVerifier:baseSepolia": "node run-addVerifier.js baseSepolia",
    "setFees:base": "hardhat run scripts/setFees.js --network base",
    "setFees:baseSepolia": "hardhat run scripts/setFees.js --network baseSepolia",
    "updateBaseURI:base": "hardhat run scripts/updateBaseURI.js --network base",
    "updateBaseURI:baseSepolia": "hardhat run scripts/updateBaseURI.js --network baseSepolia",
    "withdrawFees:base": "hardhat run scripts/withdrawFees.js --network base",
    "withdrawFees:baseSepolia": "hardhat run scripts/withdrawFees.js --network baseSepolia",
    "withdrawFeesTo:base": "hardhat run scripts/withdrawFeesTo.js --network base",
    "withdrawFeesTo:baseSepolia": "hardhat run scripts/withdrawFeesTo.js --network baseSepolia",
    "withdrawFeesThenSendTo:base": "hardhat run scripts/withdrawFeesThenSendTo.js --network base",
    "withdrawFeesThenSendTo:baseSepolia": "hardhat run scripts/withdrawFeesThenSendTo.js --network baseSepolia",
    "withdrawFeesToOwner:base": "hardhat run scripts/withdrawFeesToOwner.js --network base",
    "withdrawFeesToOwner:baseSepolia": "hardhat run scripts/withdrawFeesToOwner.js --network baseSepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@celo/contractkit": "^10.0.2",
    "dotenv": "^17.2.3"
  }
}

# DeCleanup Contracts - Environment for Hardhat deploy/scripts
# Copy to .env and fill in. DO NOT commit .env (it contains PRIVATE_KEY).

# ============================================
# Contract verification (Etherscan API V2)
# ============================================
# ETHERSCAN_API_KEY=    # preferred — https://etherscan.io/apidashboard (works for Base and 60+ chains)
# BASESCAN_API_KEY=     # fallback; V1/deprecated. For V2 use ETHERSCAN_API_KEY.
# Hardhat loads this file from contracts/ — put keys in contracts/.env, not repo root .env

# ============================================
# Deployer / Private key (REQUIRED for deploy and admin scripts)
# ============================================
# The DEPLOYER is the Ethereum address derived from this key.
# When you change PRIVATE_KEY, the deployer (and contract owner after deploy) changes.
# Use a dedicated deployer wallet; move ownership to multisig after deploy if desired.
#
PRIVATE_KEY=0x...your_private_key_here

# ============================================
# RPC (optional; scripts use these when set)
# ============================================
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_MAINNET_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_TESTNET_RPC_URL  and  NEXT_PUBLIC_RPC_URL  also work when set in root .env

# ============================================
# Deploy / config overrides (optional)
# ============================================
# BDCU_TOKEN_ADDRESS=           # or TEST_BDCU_TOKEN_ADDRESS for testnet
# POINTS_REWARD_DISTRIBUTOR_ADDRESS=
# VERIFICATION_CONTRACT_ADDRESS=
# IMPACT_PRODUCT_NFT_ADDRESS=
# INITIAL_VERIFIERS=0xaddr1,0xaddr2
# FEE_TREASURY=0x...
# INITIAL_TOKEN_PRICE=77
# IPFS_BASE_URI=ipfs://...
# SUBMISSION_FEE=0
# FEE_ENABLED=false
# CLAIM_FEE=0
# CLAIM_FEE_ENABLED=false

# For transferTokensToPointsDistributor.js:
# TRANSFER_AMOUNT=1000000000000000000000
